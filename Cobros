<!DOCTYPE html>
<html lang="es"><head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Maison Saldana · Cuentas por cobrar</title>
<meta name="robots" content="noindex,nofollow">
<style>
:root{--bg:#f5f5f4;--card:#fff;--tx:#1c1917;--mut:#78716c;--ac:#1f2937;--acx:#fff;--bd:#e7e5e4;--ok:#15803d;--bad:#b91c1c;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px);color-scheme:light}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#0c0a09;--card:#1c1917;--tx:#fafaf9;--mut:#a8a29e;--ac:#fafaf9;--acx:#1c1917;--bd:#292524;--ok:#4ade80;--bad:#f87171;color-scheme:dark}}
:root[data-theme="dark"]{--bg:#0c0a09;--card:#1c1917;--tx:#fafaf9;--mut:#a8a29e;--ac:#fafaf9;--acx:#1c1917;--bd:#292524;--ok:#4ade80;--bad:#f87171;color-scheme:dark}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--tx);font:16px/1.4 -apple-system,"Segoe UI",Arial,sans-serif}
.top{position:sticky;top:env(safe-area-inset-top,0px);background:var(--bg);padding:14px 14px 10px;border-bottom:1px solid var(--bd);z-index:5}
body::before{content:"";position:fixed;inset:0 0 auto;height:env(safe-area-inset-top,0px);background:var(--bg);z-index:10}
.lbl{color:var(--mut);font-size:13px}
.tot{font-size:34px;font-weight:700;letter-spacing:-.5px}
.sub{color:var(--mut);font-size:13px}
.wrap{max-width:560px;margin:0 auto}
.add{display:flex;gap:8px;padding:12px 14px}
input{font:inherit;color:var(--tx);background:var(--card);border:1px solid var(--bd);border-radius:10px;padding:10px;min-width:0}
.add input:first-child{flex:1}.add input.m{width:96px;text-align:right}
button{font:inherit;border:0;border-radius:10px;padding:10px 14px;background:var(--ac);color:var(--acx);font-weight:600}
button.g{background:var(--card);color:var(--tx);border:1px solid var(--bd)}
.bar{display:flex;gap:8px;padding:0 14px 8px}.bar input{flex:1}
.row{display:flex;gap:8px;align-items:center;margin:0 14px 8px;background:var(--card);border:1px solid var(--bd);border-radius:12px;padding:6px}
.row input{border:0;background:transparent;padding:8px}
.row .n{flex:1}.row .m{width:96px;text-align:right;font-weight:600}
.x{background:transparent;color:var(--bad);padding:8px 10px;font-size:18px}
.foot{display:flex;gap:8px;padding:8px 14px 24px}.foot button{flex:1}
.empty{text-align:center;color:var(--mut);padding:24px}
</style></head><body>
<div class="top"><div class="wrap">
<div class="lbl">MAISON SALDANA · Total por cobrar</div>
<div class="tot" id="tot">RD$ 0</div>
<div class="sub" id="cnt"></div>
</div></div>
<div class="wrap">
<div class="add">
<input id="nn" placeholder="Nombre" autocapitalize="words" enterkeyhint="next">
<input id="nm" class="m" placeholder="Monto" inputmode="numeric" enterkeyhint="done">
<button id="ab">Agregar</button>
</div>
<div class="bar"><input id="q" type="search" placeholder="Buscar nombre…"></div>
<div id="list"></div>
<div id="ip" style="display:none;padding:0 14px 8px"><textarea id="it" rows="8" placeholder="Pega aquí la lista, una persona por línea:&#10;Juan 800&#10;Pedro 1,000" style="width:100%;font:inherit;color:var(--tx);background:var(--card);border:1px solid var(--bd);border-radius:10px;padding:10px"></textarea><div style="display:flex;gap:8px;margin-top:8px"><button id="ig">Agregar a la lista</button><button class="g" id="ic">Cancelar</button></div></div>
<div class="foot"><button class="g" id="im">Importar lista</button><button class="g" id="cp">Copiar lista</button><button class="g" id="th">Modo claro/oscuro</button></div>
</div>
<script>
var KEY="cuentas-por-cobrar-v1";
var seed=[];
var data=[];
try{var s=localStorage.getItem(KEY);data=s?JSON.parse(s):null}catch(e){data=null}
if(!Array.isArray(data)){data=seed.map(function(r,i){return{id:i+1,n:r[0],m:r[1]}})}
var nid=data.reduce(function(a,r){return Math.max(a,r.id)},0)+1;
var $=function(i){return document.getElementById(i)};
var fmt=function(n){return Number(n||0).toLocaleString("en-US")};
var num=function(v){return parseInt(String(v).replace(/\D/g,""),10)||0};
function save(){try{localStorage.setItem(KEY,JSON.stringify(data))}catch(e){}}
function total(){var t=0;data.forEach(function(r){t+=r.m});$("tot").textContent="RD$ "+fmt(t);$("cnt").textContent=data.length+" personas";}
function render(){
 var q=$("q").value.trim().toLowerCase(),L=$("list");L.innerHTML="";
 var rows=data.slice().sort(function(a,b){return a.n.localeCompare(b.n,"es",{sensitivity:"base"})});
 rows=rows.filter(function(r){return !q||r.n.toLowerCase().indexOf(q)>-1});
 if(!rows.length){L.innerHTML='<div class="empty">No hay nadie en la lista</div>'}
 rows.forEach(function(r){
  var d=document.createElement("div");d.className="row";
  var n=document.createElement("input");n.className="n";n.value=r.n;
  n.onchange=function(){r.n=n.value.trim()||r.n;save();render()};
  var m=document.createElement("input");m.className="m";m.setAttribute("inputmode","numeric");m.value=fmt(r.m);
  m.onfocus=function(){m.select()};
  m.oninput=function(){r.m=num(m.value);total();save()};
  m.onblur=function(){m.value=fmt(r.m)};
  var x=document.createElement("button");x.className="x";x.textContent="✕";x.setAttribute("aria-label","Quitar");
  x.onclick=function(){if(confirm("¿Quitar a "+r.n+" de la lista?")){data=data.filter(function(z){return z!==r});save();render()}};
  d.appendChild(n);d.appendChild(m);d.appendChild(x);L.appendChild(d);
 });
 total();
}
function add(){
 var n=$("nn").value.trim(),m=num($("nm").value);
 if(!n){$("nn").focus();return}
 data.push({id:nid++,n:n,m:m});save();$("nn").value="";$("nm").value="";$("q").value="";render();$("nn").focus();
}
$("ab").onclick=add;
$("nn").onkeydown=function(e){if(e.key==="Enter"){e.preventDefault();$("nm").focus()}};
$("nm").onkeydown=function(e){if(e.key==="Enter"){e.preventDefault();add()}};
$("nm").oninput=function(){var v=num($("nm").value);$("nm").value=v?fmt(v):""};
$("q").oninput=render;
$("cp").onclick=function(){
 var rows=data.slice().sort(function(a,b){return a.n.localeCompare(b.n,"es",{sensitivity:"base"})});
 var t=0,txt="CUENTAS POR COBRAR\n\n";
 rows.forEach(function(r,i){t+=r.m;txt+=(i+1)+". "+r.n+" "+fmt(r.m)+"\n"});
 txt+="\nTOTAL: "+fmt(t);
 var ok=function(){$("cp").textContent="¡Copiado!";setTimeout(function(){$("cp").textContent="Copiar lista"},1500)};
 try{navigator.clipboard.writeText(txt).then(ok,function(){prompt("Copia esto:",txt)})}catch(e){prompt("Copia esto:",txt)}
};
$("th").onclick=function(){
 var r=document.documentElement,dk=r.getAttribute("data-theme")==="dark"||(!r.getAttribute("data-theme")&&matchMedia("(prefers-color-scheme: dark)").matches);
 r.setAttribute("data-theme",dk?"light":"dark");
};
$("im").onclick=function(){$("ip").style.display="block";$("it").focus()};
$("ic").onclick=function(){$("ip").style.display="none";$("it").value=""};
$("ig").onclick=function(){
 var c=0;
 $("it").value.split(/\n/).forEach(function(l){
  l=l.replace(/^\s*\d+[.)]\s+/,"").trim();
  var m=l.match(/^(.*\S)\s+([\d,]+)$/);
  if(!m||/^(total|cuentas)/i.test(l))return;
  data.push({id:nid++,n:m[1],m:num(m[2])});c++;
 });
 save();render();$("ic").onclick();alert(c+" personas agregadas");
};
render();
</script></body></html>
